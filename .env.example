# ==========================================
# RLCF Study Plan - Local Environment Configuration
# Copy this file to .env and fill in your values
# ==========================================

# --- LLM API Keys (At least one required for study plan generation) ---
# Google Gemini API key (recommended, free at https://aistudio.google.com)
# Also used for primary automated video transcription
GEMINI_API_KEY=

# Anthropic Claude API key (optional alternative)
# ANTHROPIC_API_KEY=

# --- Bible Translation for Scripture Links ---
# Options: NASB1995 (default), NKJV, ESV, NIV, KJV, NLT, CSB
BIBLE_TRANSLATION=NASB1995

# --- Local Overrides (Optional) ---
# Override specific YouTube video URL or ID instead of scraping rlcf.church
# YOUTUBE_VIDEO_ID=

# Override memory verse text
# MEMORY_VERSE=

# Path to a local transcript text file to bypass YouTube completely
# TRANSCRIPT_FILE=

# Force regeneration even if week-YYYY-MM-DD.json already exists (1 or true)
# FORCE_REGENERATE=0

# --- Email / SMTP Settings (Optional, for send_daily_portion.py) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=recipient@example.com

# --- Slack Integration (Optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
